# Base de données PostgreSQL (ex: Neon, Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/bdautomobile?schema=public"

# Cloudinary (stockage et optimisation des photos/vidéos véhicules)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Authentification de l'administration
# Hash bcrypt du mot de passe admin (ne jamais mettre le mot de passe en clair).
# Important : dans un fichier .env local, échapper chaque $ en \$ (ex: \$2b\$12\$...)
# car Next.js interprète sinon $xxx comme une variable. Sur Vercel (variables
# d'environnement du dashboard), ce n'est pas nécessaire : coller la valeur telle quelle.
ADMIN_PASSWORD_HASH=""
# Clé aléatoire servant à signer les sessions (générer avec: openssl rand -base64 32)
AUTH_SECRET=""
